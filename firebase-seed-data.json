    "faqs": {
      "faq_1": { "id": "faq_1", "q": "How do I play the math puzzle?", "a": "Select an empty cell on the cross-math board, then tap a number tile from your tray at the bottom to place it. Complete every horizontal and vertical equation accurately to clear the stage!" },
      "faq_2": { "id": "faq_2", "q": "How are XP and Coins calculated?", "a": "Each stage awards base XP and Coins according to your Campaign Level tier (Easy, Medium, or Hard). Maintaining a high combo streak and finishing quickly multiplies your rewards!" },
      "faq_3": { "id": "faq_3", "q": "What are Hints and how do I get more?", "a": "Tapping the Hint bulb automatically places the correct number tile into your selected slot. You can unlock extra hints using Coins or Gems from the Store." },
      "faq_4": { "id": "faq_4", "q": "How does the Daily Challenge work?", "a": "Every calendar day features a special 3-stage challenge. Completing daily challenges builds your monthly streak and unlocks bonus trophy milestones!" },
      "faq_5": { "id": "faq_5", "q": "Is my progress saved automatically?", "a": "Yes! Your unlocked levels, XP, coins, gems, custom profile, and puzzle history are saved both locally on your device and synced in real time to the NewroMath Firebase Cloud Database." }
    }
